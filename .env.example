# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Database: "mongo" (current) or "postgres" (planned)
DB_CLIENT=mongo

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/matchbox

# PostgreSQL (used when DB_CLIENT=postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/matchbox
