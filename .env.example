# Server
PORT=4000
NODE_ENV=development
# Comma-separated list of storefront URLs
CORS_ORIGIN=http://localhost:3000

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_DAYS=7

# Database: "mongo" (current) or "postgres" (planned)
DB_CLIENT=mongo

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/matchbox

# PostgreSQL (used when DB_CLIENT=postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/matchbox

# Number of proxies in front of the API (0 = clients connect directly; 1 behind Nginx/Cloudflare)
TRUST_PROXY=0

# Shared secret sent by the storefront server so SSR requests skip per-IP rate limits.
# Must match INTERNAL_API_KEY in frontend/.env.local. Generate like JWT_SECRET.
INTERNAL_API_KEY=change-me-to-a-long-random-string-at-least-32-chars

# Storefront URL the API notifies to refresh cached pages after admin changes
# (defaults to the first CORS_ORIGIN)
# STOREFRONT_URL=http://localhost:3000
